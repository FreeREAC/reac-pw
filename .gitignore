# build dirs
/build/
/builddir/
# a lane builds beside the default one, so
# `git status` in a worktree is not buried under an untracked build tree
/build-*/


# editor / scratch
*.o
*.a
*.swp

# rpm build artifact
reac-pw-*.tar.gz
logs/
/_build/

# compiled Python embeds the build machine paths
__pycache__/
*.py[co]

# inputs a fuzz run crashed on (make -C fuzz fuzz-run)
/fuzz/findings/

#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# --wrap-mode=nofallback: no dependency is ever fetched; libreac comes from the installed libreac-dev.
override_dh_auto_configure:
	dh_auto_configure -- --buildtype=plain --wrap-mode=nofallback

# The namespace tests run one at a time. Each mints a veth pair, a nested network namespace and
# its own PipeWire; meson's default of one process per core makes them race for the builder's
# namespace and PipeWire startup budget, so the losers time out.
override_dh_auto_test:
	dh_auto_test -- --no-suite netns --no-suite load
	dh_auto_test -- --no-suite load --suite netns --num-processes 1

# The NetworkManager guard is a SYSTEM unit (debian/reac-pw.reac-pw-nm-unmanaged.service is
# packaging/'s file): enabled and started on install, stopped on removal. The script is
# installed without its .sh, the name the unit runs.
override_dh_installsystemd:
	dh_installsystemd --name=reac-pw-nm-unmanaged

execute_after_dh_install:
	mv debian/reac-pw/usr/lib/reac-pw/reac-pw-nm-unmanaged.sh debian/reac-pw/usr/lib/reac-pw/reac-pw-nm-unmanaged

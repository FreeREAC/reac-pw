#
# Installed as /usr/lib/systemd/system-preset/90-reac-pw-nm-unmanaged.preset. A SYSTEM unit
# that runs as root and writes only NetworkManager's drop-in for the interfaces reac-pw
# marks; enabled on install so a REAC NIC is left alone from the first boot after it.
enable reac-pw-nm-unmanaged.service

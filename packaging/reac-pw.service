[Unit]
Description=PipeWire-native REAC endpoint (reac-pw)
Documentation=https://github.com/FreeREAC/reac-aes67
After=pipewire.service
Wants=pipewire.service

# ONE MASTER PER SEGMENT IS REAC LAW, and two masters on one wire go mute. Any
# hand-run or per-NIC unit must be stopped and DISABLED before this one starts;
# an enabled leftover is a second master waiting for the next login.
Conflicts=reac-pw-master.service

[Service]
Type=simple
# ONE daemon, N listeners (docs/design/specs/2026-08-20-reac-auto-spine.md §5,
# the openmixer tree), and nothing names an interface (the trunk-VLAN spec
# there, amendment 2026-09-02): this unit passes NO interface, NO --rate and
# NO --headamp — the daemon hears its segments on every linked Ethernet
# interface, and every setting comes from the one conf reac_conf.h reads,
# %h/.config/reac-pw/reac-pw.env (host-wide REAC_MIXER/REAC_RATE/REAC_ROLE,
# and per-segment REAC_<KEY>_<segment> above them); packaging/reac-pw.conf is
# the commented worked example for this rig's own two segments. This unit needs
# HOME, so it is a USER unit — a bare system unit with no HOME cannot find either
# file, or the user's PipeWire socket.
#
# NO EnvironmentFile= (#100). The DAEMON reads that file, through reac_conf's own
# layered lookup, and it is the only reader that can: a per-segment key on a VLAN
# is `REAC_ROLE_enp131s0.11`, and A DOT IS NOT LEGAL in a systemd environment
# variable name. Measured 2026-09-14 on reac-pw 1.0.2: systemd logged `Ignoring
# invalid environment assignment` once per VLAN segment on every start, so the
# line published nothing the daemon did not already have and printed a false
# `invalid` over every pin that was in fact being applied. One store, one reader —
# and the reader is the daemon.
ExecStart=/usr/bin/reac-pw
# raw 0x8819 capture/emit + VLAN sub-interface management + the SCHED_FIFO
# pacer, all WITHOUT running as root: FILE capabilities on the binary
# (rpm's %caps, applied by rpm itself at install — see packaging/reac-pw.spec)
# are the mechanism, so no AmbientCapabilities= belongs here (a user unit
# cannot grant ambient capabilities anyway, and the line was inert on this
# unit even before that). The bounding set must include everything the file
# capabilities grant — narrower than that silently drops what setcap gave.
# NO CapabilityBoundingSet. This is a USER unit — `%h` and the PipeWire socket
# require it — and a user manager cannot set one: systemd refuses the unit with
# 218/CAPABILITIES before the binary ever runs. Privilege comes from the FILE
# capabilities rpm applies (%caps in the spec), which need no help from systemd
# and survive `rpm -V`. Measured 2026-08-31: with this line present the service
# never started once.
# run in the operator's PipeWire session bus
Restart=on-failure
RestartSec=2
# realtime scheduling for the audio path (MiniPC PREEMPT_RT)
LimitRTPRIO=95
LimitMEMLOCK=infinity

[Install]
WantedBy=default.target

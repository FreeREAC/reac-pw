# reac-pw.conf — commented WORKED EXAMPLE of the ONE OVERRIDE FILE, not a file the RPM
# installs and not a file reac-pw or a console ever writes.
#
# COPY IT TO ~/.config/reac-pw/reac-pw.conf ONLY IF YOU NEED ONE OF THE TWO THINGS BELOW.
# With no such file — the normal case, and the shipping default — the daemon works the rig
# out for itself (2026-09-16-segments-and-roles-are-autodetected):
#
#   * every UP Ethernet interface that is not loopback and not wireless is sniffed by a
#     passive 0x8819 socket, and becomes a SEGMENT on the first REAC frame heard on it;
#   * every VLAN sub-interface IS an interface, so it is found by the same rule;
#   * a tagged VLAN id heard on a trunk with no sub-interface is created (or, without
#     CAP_NET_ADMIN, named in a refusal with the `ip link` line that would fix it);
#   * an interface that appears or disappears while the daemon runs adds or removes its
#     segment with no restart;
#   * and every segment's ROLE is `auto`: a box mastering the wire is slave-joined, a desk
#     mastering it is tapped, a silent wire is listened to and knocked on by a bounded,
#     backed-off plan (docs/KNOCK.md) and mastered once a box answers. A trunk parent stops
#     knocking when its VLANs carry REAC and is never a segment, so a trunk NIC needs no
#     `ignore = yes` here.
#
# THIS FILE IS THE EXCEPTION, AND reac-pw.env IS NOT. `REAC_ROLE` and `REAC_ROLE_<segment>`
# no longer decide anything, in any layer: a role written before there was anything to
# decide against outlives the rig it described, and on 2026-09-16 exactly that served three
# mirror ports on a fabric with no mirror — every node up, every counter green, no audio.
# reac-pw.env keeps the host-wide keys that are NOT about which end of a wire we are
# (REAC_RATE, REAC_MIXER, REAC_NAME, REAC_HEADAMP, ...); see packaging/reac-pw.env.example.

# ============================================================================
# [segment <interface>] — one section per segment you need to say something about.
# The name is the INTERFACE name, which IS the segment's identity. It is
# case-SENSITIVE, because the kernel compares interface names byte for byte.
# Keys, the `segment` keyword and the values are case-insensitive.
# `#` and `;` start a comment at the line start or after whitespace.
# ============================================================================

# A SWITCH MIRROR PORT. A tap serves what it hears and transmits NOTHING: no announce, no
# join, no grant, no segment lock, no TX socket. This is the role for watching a Roland
# desk's own fabric, and it is only useful on a mirror port — an established box unicasts
# to its desk, so a plain trunk membership shows you the desk's downstream and nothing of
# the stage.
#[segment enp131s0.11]
#role = tap

# A RECORDER. `slave` courts the desk for a grant, which a real desk answers — and which
# was measured to keep that desk's own S-1608 from enrolling for 180 s (2026-09-12). Ask
# for it deliberately or not at all.
#[segment enp131s0.12]
#role = slave

# A WIRE WE DRIVE WHATEVER WE HEAR. Rarely what you want: `auto` already knocks on a silent
# wire and masters it once a box answers, and a pin cannot beat a box that is already
# mastering: it joins it. A pin streams on link without waiting for an answer.
#[segment enp131s0.1]
#role = master

# SWITCH A SEGMENT OFF ENTIRELY. Never sniffed, never served, never minted; its netdev is
# left exactly as found. For a NIC that carries REAC you do not want this host to touch.
# It is NOT needed for a trunk NIC or a NIC with no REAC on it: since reac-pw#40 such a wire
# is listened to and knocked on, never streamed at. A file that still carries it for that
# reason is honoured, and the daemon says at start that it is no longer needed.
#[segment enp131s0.13]
#ignore = yes

# HOW A SILENT WIRE IS KNOCKED ON: `escalate` (the default: two control knocks, then one
# cycle of the stream a real box was seen to answer), `control` (never an audio filler) or
# `stream` (the stream cycle on every knock). Every plan keeps the same caps: at most three
# stream knocks until something is heard, and a period that doubles up to 30 s. It exists
# for the rig check in docs/KNOCK.md; a rig whose boxes enrol needs no such line.
#[segment enp131s0]
#knock = control

# NAMING A VLAN. `[segment <parent>.<vid>]` names a VLAN IF IT EXISTS: its role and ignore
# apply when that VID is heard on the parent and the daemon creates the sub-interface. It
# creates NOTHING by itself (ruling 2026-09-23). A cold box that came up before the daemon
# sends no tag, so for it the sub-interface must be in the host's network config
# (README, "A box behind a trunk"); a box that speaks, or powers up while the daemon runs,
# names its VLAN by itself.
#[segment enp131s0.14]

# ============================================================================
# DROP-INS — ~/.config/reac-pw/reac-pw.conf.d/*.conf
#
# The same grammar, in a directory. reac-pw reads THIS file first, then every `*.conf`
# under `reac-pw.conf.d/` in byte order of the file name, and a LATER file overrides the
# same key of the same segment — exactly like systemd units, sysctl.d and udev. A key a
# later file does not mention keeps whatever the earlier one said.
#
# That is the door another program writes through, and a console writes exactly one file:
#
#     ~/.config/reac-pw/reac-pw.conf.d/50-openmixer.conf
#
# It never touches THIS file, because a generated file cannot be an operator's override.
# And you keep the last word without editing anything it owns: a drop-in of your own whose
# name sorts later wins.
#
#     ~/.config/reac-pw/reac-pw.conf.d/99-local.conf
#     [segment enp131s0.11]
#     role = tap
#
# The daemon prints, at start, every file it read IN ORDER and which file set each override,
# so a role you did not expect is one journal line from the file that set it. A drop-in it
# cannot read is named and skipped; the files it can read still apply.
